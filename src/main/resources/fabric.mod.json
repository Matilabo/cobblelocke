{
  "schemaVersion": 1,
  "id": "cobblelocke",
  "version": "${version}",
  "name": "Cobblelocke",
  "description": "Cobblemon Randomlocke: Cobblemon randomizer and nuzlocke challenge in one mod, with world-wide global pools and biome event locks with some neat animations.",
  "authors": ["Matilabo"],
  "license": "MPL-2.0",
  "icon": "assets/cobblelocke/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.cobblelocke.Cobblelocke"],
    "client": ["com.cobblelocke.client.CobblelockeClient"]
  },
  "mixins": [
    "cobblelocke.mixins.json",
    {
      "config": "cobblelocke.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cobblemon": ">=1.8.0"
  },
  "breaks": {
    "cobblemon_randomizer": "*",
    "cobblemon_nuzlocke": "*"
  }
}
